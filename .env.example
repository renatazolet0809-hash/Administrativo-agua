# Conexión a la base de datos (SQLite — ruta relativa a la carpeta prisma/)
DATABASE_URL="file:../db/custom.db"

# Clave secreta para firmar los tokens de sesión (JWT/HMAC).
# En producción usa una cadena larga y aleatoria, ej: openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"
