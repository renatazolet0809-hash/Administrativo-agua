# ============================================================
# Base de datos — PostgreSQL en Neon (deploy en Vercel)
# ============================================================
# Neon te da DOS cadenas de conexión (Dashboard → Connection Details):
#
#  1) POOLED  (recomendada para la app en Vercel/serverless):
#     termina en "-pooler" y agrégale "?pgbouncer=true&connect_timeout=15"
#  2) DIRECT  (para migraciones / prisma db push):
#     la que NO termina en "-pooler"
#
# En Vercel (Project → Settings → Environment Variables) configura:
#   DATABASE_URL = cadena POOLED con ?pgbouncer=true&connect_timeout=15
#   DIRECT_URL   = cadena DIRECT
#
# Si tu Postgres no usa pooler (p. ej. Postgres local), pon la MISMA
# cadena en las dos variables.

DATABASE_URL="postgresql://usuario:password@ep-ejemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clave secreta para firmar los tokens de sesión (JWT/HMAC).
# Genera una con: openssl rand -base64 48
AUTH_SECRET="cambia-esta-clave-por-una-larga-y-aleatoria"

# ------------------------------------------------------------
# Desarrollo local con SQLite (opcional, sin Neon):
# usa el schema por defecto (prisma/schema.prisma) con:
#   DATABASE_URL="file:../db/custom.db"
# y quita/comenta DIRECT_URL. Comandos: npm run db:push / db:generate
# ------------------------------------------------------------
